---
import type { LessonSummary } from '../../utils/lessons';
import { DIFFICULTY_LABELS } from '../../utils/tracks';
import StatusBadge from '../ui/StatusBadge.astro';

interface Props {
  lesson: LessonSummary;
  showTrackBadge?: boolean;
}

const { lesson, showTrackBadge = true } = Astro.props;
---

<article class="vl-lesson-card">
  <div class="vl-lesson-card__meta">
    {showTrackBadge && (
      <StatusBadge variant="accent">
        Stage {lesson.trackStage} · {lesson.trackTitle}
      </StatusBadge>
    )}
    <StatusBadge variant="neutral">
      {DIFFICULTY_LABELS[lesson.difficulty]}
    </StatusBadge>
    <span>{lesson.estimatedMinutes} min read</span>
  </div>

  <h3 class="vl-lesson-card__title">
    <a href={lesson.href}>{lesson.title}</a>
  </h3>

  <p>{lesson.description}</p>

  <ul class="vl-lesson-card__tags" aria-label="Lesson tags">
    {lesson.tags.map((tag) => (
      <li class="vl-tag">#{tag}</li>
    ))}
  </ul>

  <div class="lesson-card__footer">
    <a href={lesson.href} class="lesson-card__cta">
      Read lesson <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>

<style>
  .lesson-card__footer {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .lesson-card__cta {
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .lesson-card__cta:hover {
    text-decoration: underline;
  }
</style>
