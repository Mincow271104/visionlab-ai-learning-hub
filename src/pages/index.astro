---
import MainLayout from '../layouts/MainLayout.astro';
import LessonCard from '../components/learning/LessonCard.astro';
import RoadmapTrackCard from '../components/learning/RoadmapTrackCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import { getPublishedLessons, toLessonSummary } from '../utils/lessons';
import { LEARNING_TRACKS } from '../utils/tracks';
import { withBase } from '../utils/url';

const publishedSummaries = (await getPublishedLessons()).map(toLessonSummary);

const featuredIds = new Set([
  'ai-fundamentals/what-is-artificial-intelligence',
  'machine-learning/understanding-svm-and-kernel-trick',
  'deep-learning/understanding-neural-networks',
  'computer-vision/how-computers-see-images',
]);

const featuredLessons = publishedSummaries.filter((lesson) =>
  featuredIds.has(lesson.id)
);

const platformStatus = [
  {
    name: 'Guided 5-Track Roadmap',
    status: 'Available now',
    variant: 'teal' as const,
    href: withBase('/roadmap/'),
    detail:
      'Follow a structured five-stage sequence across AI Fundamentals, Machine Learning, Deep Learning, Computer Vision, and Generative AI.',
  },
  {
    name: `${publishedSummaries.length} Beginner-Friendly Lessons`,
    status: 'Available now',
    variant: 'teal' as const,
    href: withBase('/explore/'),
    detail:
      'Consistent 11-section articles teaching visual intuition before equations, with original diagrams and Knowledge Check quizzes.',
  },
  {
    name: 'Interactive Conceptual Sandboxes',
    status: 'Available now',
    variant: 'teal' as const,
    href: withBase('/lessons/machine-learning/understanding-svm-and-kernel-trick/'),
    detail:
      'Explore geometric margins in the SVM Playground and step through real forward-pass calculations in the Neural Network Explorer.',
  },
  {
    name: 'Local Browser Progress & Quiz History',
    status: 'Available now',
    variant: 'teal' as const,
    href: withBase('/my-learning/'),
    detail:
      'Track lesson completion and quiz scores directly in your browser with no account required, plus planned expansion in future packages.',
  },
] as const;

const roadmapHref = withBase('/roadmap/');
const exploreHref = withBase('/explore/');
---

<MainLayout
  title="VisionLab — AI & Computer Vision Learning Hub"
  description="See It. Try It. Understand It. A beginner-friendly learning hub for artificial intelligence and computer vision."
>
  <section id="overview" class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <div class="hero__badges">
          <StatusBadge variant="accent">
            {publishedSummaries.length} Interactive Lessons Live
          </StatusBadge>
          <StatusBadge variant="neutral">Beginner-Friendly</StatusBadge>
        </div>

        <h1 class="hero__title">
          VisionLab
          <span class="hero__tagline">See It. Try It. Understand It.</span>
        </h1>

        <p class="hero__intro">
          Artificial intelligence and computer vision do not have to begin with
          dense equations or prior coding experience. VisionLab helps curious
          beginners build accurate mental models through clear analogies,
          labeled diagrams, and hands-on conceptual demonstrations.
        </p>

        <div class="hero__actions">
          <a href={roadmapHref} class="btn btn--primary">
            Start Guided Roadmap
          </a>
          <a href={exploreHref} class="btn btn--secondary">
            Explore All Lessons
          </a>
        </div>
      </div>

      <figure class="hero__visual" aria-labelledby="hero-diagram-caption">
        <svg
          class="hero__svg"
          viewBox="0 0 460 320"
          fill="none"
          role="img"
          aria-labelledby="hero-svg-title hero-svg-desc"
        >
          <title id="hero-svg-title">
            VisionLab Three-Step Learning Loop
          </title>
          <desc id="hero-svg-desc">
            A conceptual diagram showing three connected stages: See It (labeled
            diagrams), Try It (interactive controls), and Understand It (clear
            mental models).
          </desc>

          <rect
            x="8"
            y="8"
            width="444"
            height="304"
            rx="20"
            class="diagram-frame"
          />

          <!-- Connection arrows -->
          <path
            d="M150 118 H172"
            class="diagram-connector"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <path
            d="M167 112 L175 118 L167 124"
            class="diagram-connector"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M308 118 H330"
            class="diagram-connector"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <path
            d="M325 112 L333 118 L325 124"
            class="diagram-connector"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <!-- Step 1: See It -->
          <g>
            <rect
              x="28"
              y="48"
              width="120"
              height="148"
              rx="14"
              class="diagram-card"
            />
            <circle cx="88" cy="88" r="22" class="diagram-pill-blue" />
            <path
              d="M72 88C76.5 80 82 76 88 76C94 76 99.5 80 104 88C99.5 96 94 100 88 100C82 100 76.5 96 72 88Z"
              class="diagram-stroke-blue"
              stroke-width="2.2"
            />
            <circle cx="88" cy="88" r="4.5" class="diagram-dot-blue" />
            <text x="88" y="136" text-anchor="middle" class="diagram-label">
              1. See It
            </text>
            <text x="88" y="156" text-anchor="middle" class="diagram-sublabel">
              Visual intuition
            </text>
            <text x="88" y="172" text-anchor="middle" class="diagram-sublabel">
              before formulas
            </text>
          </g>

          <!-- Step 2: Try It -->
          <g>
            <rect
              x="178"
              y="48"
              width="128"
              height="148"
              rx="14"
              class="diagram-card diagram-card--highlight"
            />
            <circle cx="242" cy="88" r="22" class="diagram-pill-blue" />
            <line
              x1="227"
              y1="82"
              x2="257"
              y2="82"
              class="diagram-stroke-blue"
              stroke-width="2.2"
              stroke-linecap="round"
            />
            <circle cx="248" cy="82" r="4" class="diagram-dot-blue" />
            <line
              x1="227"
              y1="94"
              x2="257"
              y2="94"
              class="diagram-stroke-blue"
              stroke-width="2.2"
              stroke-linecap="round"
            />
            <circle cx="235" cy="94" r="4" class="diagram-dot-blue" />
            <text x="242" y="136" text-anchor="middle" class="diagram-label">
              2. Try It
            </text>
            <text x="242" y="156" text-anchor="middle" class="diagram-sublabel">
              Adjust inputs &amp;
            </text>
            <text x="242" y="172" text-anchor="middle" class="diagram-sublabel">
              observe behavior
            </text>
          </g>

          <!-- Step 3: Understand It -->
          <g>
            <rect
              x="334"
              y="48"
              width="102"
              height="148"
              rx="14"
              class="diagram-card"
            />
            <circle cx="385" cy="88" r="22" class="diagram-pill-teal" />
            <path
              d="M375 88 L382 95 L396 81"
              class="diagram-stroke-teal"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <text x="385" y="136" text-anchor="middle" class="diagram-label">
              3. Understand
            </text>
            <text x="385" y="156" text-anchor="middle" class="diagram-sublabel">
              Connect ideas
            </text>
            <text x="385" y="172" text-anchor="middle" class="diagram-sublabel">
              &amp; check limits
            </text>
          </g>

          <!-- Bottom summary bar -->
          <rect
            x="28"
            y="222"
            width="408"
            height="62"
            rx="12"
            class="diagram-footer-bar"
          />
          <text x="48" y="248" class="diagram-bar-title">
            Hybrid Learning Platform
          </text>
          <text x="48" y="268" class="diagram-sublabel">
            Follow the 5-track guided path or explore individual lessons freely.
          </text>
        </svg>
        <figcaption id="hero-diagram-caption" class="hero__caption">
          VisionLab pairs plain-English visual explanations with focused
          interactive exploration so beginners understand why concepts work, not
          just what they are called.
        </figcaption>
      </figure>
    </div>
  </section>

  <section id="roadmap" class="section section--subtle" aria-labelledby="roadmap-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Learning Roadmap"
        headingId="roadmap-heading"
        title="Five tracks from AI basics to computer vision and generative models"
        description="Select any track to view its published lessons in recommended order, or open the full roadmap to see your sequence."
      />

      <div class="tracks-grid">
        {LEARNING_TRACKS.map((track) => {
          const trackLessons = publishedSummaries.filter(
            (lesson) => lesson.track === track.id
          );
          return <RoadmapTrackCard track={track} lessons={trackLessons} />;
        })}
      </div>

      <div class="section-cta">
        <a href={roadmapHref} class="btn btn--secondary">
          Open Full Learning Roadmap &rarr;
        </a>
      </div>
    </div>
  </section>

  <section id="featured" class="section" aria-labelledby="featured-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Featured Lessons"
        headingId="featured-heading"
        title="Start with core intuition or jump into interactive sandboxes"
        description="Every lesson below is self-contained and includes diagrams, step-by-step walkthroughs, real-world examples, and a Knowledge Check."
      />

      <div class="featured-grid">
        {featuredLessons.map((lesson) => (
          <LessonCard lesson={lesson} />
        ))}
      </div>

      <div class="section-cta">
        <a href={exploreHref} class="btn btn--primary">
          Search &amp; Filter All {publishedSummaries.length} Lessons &rarr;
        </a>
      </div>
    </div>
  </section>

  <section
    id="planned-sections"
    class="section section--subtle"
    aria-labelledby="planned-heading"
  >
    <div class="container">
      <SectionHeading
        eyebrow="Platform Capabilities"
        headingId="planned-heading"
        title="What you can explore in VisionLab today"
        description="Core guided tracks, seven published lessons, interactive SVM and neural network explorers, client-side search, and local browser progress are live. Additional visualizers such as convolution demos remain planned for future expansion."
      />

      <div class="status-grid">
        {platformStatus.map((item) => (
          <article class="status-card">
            <div class="status-card__header">
              <h3 class="status-card__title">
                <a href={item.href}>{item.name}</a>
              </h3>
              <StatusBadge variant={item.variant}>{item.status}</StatusBadge>
            </div>
            <p class="status-card__detail">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .hero {
    padding-block: var(--space-10) var(--space-12);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-12) var(--space-16);
    }
  }

  .hero__grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-10);
    }
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .hero__title {
    font-size: clamp(2.1rem, 4.4vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }

  .hero__tagline {
    display: block;
    margin-top: var(--space-2);
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.015em;
  }

  .hero__intro {
    font-size: 1.06rem;
    line-height: 1.7;
    max-width: 38rem;
    margin-bottom: var(--space-6);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__visual {
    margin: 0;
    padding: var(--space-4);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .hero__svg {
    width: 100%;
    height: auto;
  }

  .hero__caption {
    margin-top: var(--space-3);
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* SVG theme-aware styling */
  .diagram-frame {
    fill: var(--color-bg-subtle);
    stroke: var(--color-border);
    stroke-width: 1.5;
  }

  .diagram-card {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1.5;
  }

  .diagram-card--highlight {
    stroke: var(--color-accent-border);
  }

  .diagram-connector {
    stroke: var(--color-accent);
  }

  .diagram-pill-blue {
    fill: var(--color-accent-soft);
  }

  .diagram-stroke-blue {
    stroke: var(--color-accent);
  }

  .diagram-dot-blue {
    fill: var(--color-accent);
  }

  .diagram-pill-teal {
    fill: var(--color-teal-soft);
  }

  .diagram-stroke-teal {
    stroke: var(--color-teal);
  }

  .diagram-footer-bar {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1.25;
  }

  .diagram-label {
    fill: var(--color-text);
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 700;
  }

  .diagram-bar-title {
    fill: var(--color-text);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
  }

  .diagram-sublabel {
    fill: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 500;
  }

  /* Grids */
  .tracks-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 680px) {
    .tracks-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .tracks-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .featured-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .section-cta {
    margin-top: var(--space-8);
    display: flex;
    justify-content: flex-start;
  }

  .status-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .status-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .status-card {
    padding: var(--space-5);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .status-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .status-card__title {
    font-size: 1.05rem;
    font-weight: 700;
  }

  .status-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .status-card__title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .status-card__detail {
    font-size: 0.93rem;
  }
</style>
