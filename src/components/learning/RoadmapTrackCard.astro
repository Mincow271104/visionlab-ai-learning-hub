---
import { getTrackHref, type LessonSummary } from '../../utils/lessons';
import type { LearningTrackInfo } from '../../utils/tracks';
import StatusBadge from '../ui/StatusBadge.astro';

interface Props {
  track: LearningTrackInfo;
  lessons?: readonly LessonSummary[];
}

const { track, lessons = [] } = Astro.props;
const trackHref = getTrackHref(track.id);
const publishedCount = lessons.length;
---

<article class="track-card" aria-labelledby={`track-title-${track.id}`}>
  <div class="track-card__top">
    <span class="track-card__stage">{track.shortLabel}</span>
    <StatusBadge variant={publishedCount > 0 ? 'teal' : 'amber'}>
      {publishedCount > 0
        ? `${publishedCount} ${publishedCount === 1 ? 'lesson' : 'lessons'} available`
        : 'Planned · Coming soon'}
    </StatusBadge>
  </div>

  <h3 id={`track-title-${track.id}`} class="track-card__title">
    <a href={trackHref}>{track.title}</a>
  </h3>

  <p class="track-card__summary">{track.summary}</p>

  <div class="track-card__topics">
    {publishedCount > 0 ? (
      <>
        <p class="track-card__topics-label">Published lessons</p>
        <ul class="track-card__topics-list">
          {lessons.map((lesson) => (
            <li>
              <a href={lesson.href}>{lesson.title}</a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <>
        <p class="track-card__topics-label">Planned topics</p>
        <ul class="track-card__topics-list">
          {track.sampleTopics.map((topic) => (
            <li>{topic}</li>
          ))}
        </ul>
      </>
    )}
  </div>

  <div class="track-card__footer">
    <a href={trackHref} class="track-card__link">
      Explore {track.title} <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>

<style>
  .track-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .track-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-sm);
  }

  .track-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .track-card__stage {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .track-card__title {
    font-size: 1.18rem;
    font-weight: 700;
  }

  .track-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .track-card__title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .track-card__summary {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .track-card__topics {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .track-card__topics-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .track-card__topics-list {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
  }

  .track-card__footer {
    padding-top: var(--space-2);
  }

  .track-card__link {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .track-card__link:hover {
    text-decoration: underline;
  }
</style>
